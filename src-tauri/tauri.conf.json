{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nexo",
  "mainBinaryName": "Nexo",
  "version": "0.1.2",
  "identifier": "com.nexushub.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sebastián",
    "copyright": "© 2026 Nexo",
    "shortDescription": "Video, música, documentos y calendario en una sola ventana.",
    "longDescription": "Nexo reúne YouTube, Spotify, conversión de documentos y un calendario de cumpleaños en una sola aplicación con el lenguaje de diseño Fluent de Windows 11.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "instalador/barra-lateral.bmp",
        "headerImage": "instalador/encabezado.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RjM4ODQzNEE0NDQ2MEQKUldRTlJrUktRNGp6VmZzR2lTVkVNNEplb1l6RU9LNzhkdkZ1MjRiek9VYVhMeHlsaTJ6SkVzTysK",
      "endpoints": ["https://github.com/SebastianSKS/nexushub/releases/latest/download/latest.json"]
    }
  }
}
